# Chave que o seu sistema (ERP/agenda) usa para chamar POST /api/notifications
API_KEY=troque-por-uma-chave-longa-aleatoria

# OpenRouter (bot). Sem a chave, o bot responde em modo eco "[sem IA]".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provedor de voz: twilio (recomendado) ou nvoip
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio que aparece no visor do cliente (E.164, ex.: +551150286739)
TWILIO_CALLER=
TWILIO_VOICE=Polly.Camila
# WhatsApp: twilio (oficial) ou evolution (não oficial, via QR code)
WHATSAPP_PROVIDER=twilio
TWILIO_WHATSAPP_FROM=

# Nvoip (painel → API). Preferencial: credencial OAuth 'Client credentials'
# (escopos: call:make, call:query). O sistema busca o token sozinho.
NVOIP_CLIENT_ID=
NVOIP_CLIENT_SECRET=
NVOIP_TOKEN_URL=https://api.nvoip.com.br/auth/oauth2/token
# Alternativa antiga: napikey (API v2).
NVOIP_NAPIKEY=
# Alternativa: token Bearer estático (API v3). Preencha um dos dois.
NVOIP_ACCESS_TOKEN=
# Quem liga: seu numbersip (painel → API) ou seu número virtual (55DDDNUMERO)
NVOIP_CALLER=

# Evolution API (WhatsApp)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_APIKEY=troque-por-outra-chave-longa
EVOLUTION_INSTANCE=ligacao
# Segredo da URL do webhook (mesmo valor usado ao registrar o webhook na Evolution)
WEBHOOK_TOKEN=troque-por-um-segredo-aleatorio

# Nome do negócio que o bot usa ao se apresentar
BUSINESS_NAME=Minha Empresa

# true = não chama Nvoip/Evolution de verdade (só loga). Comece com true.
DRY_RUN=true
# true = habilita POST /dev/chat para testar o bot sem WhatsApp
DEV_MODE=true
